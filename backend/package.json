{
  "name": "course-management-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB + JWT + Socket.IO API for the Course Management System",
  "main": "server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "create-admin": "node scripts/createAdmin.js",
    "test": "node --test test/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5"
  },
  "optionalDependencies": {
    "mongodb-memory-server": "^10.1.2"
  },
  "devDependencies": {
    "socket.io-client": "^4.7.5"
  }
}
