PORT=5000
NODE_ENV=development

# MongoDB. Local:  mongodb://127.0.0.1:27017/course_management
# Atlas:           mongodb+srv://<user>:<password>@<cluster>.mongodb.net/course_management
# If left EMPTY in development, a built-in local MongoDB starts automatically (data kept in backend/data).
MONGO_URI=

# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_random_secret
JWT_EXPIRES_IN=1h

# Frontend origin(s), comma separated. Add your Vercel URL in production.
CLIENT_URL=http://localhost:5173

# First admin account (created automatically on startup / by `npm run create-admin`).
ADMIN_NAME=Course Admin
ADMIN_EMAIL=admin@coursemanagement.com
ADMIN_ID=ADM-1042
ADMIN_PASSWORD=change_me_to_12_plus_chars

# Demo data (sample courses are always seeded when the collection is empty).
# true = also create demo students (Asha / Ravi) with progress, chat and notifications.
SEED_DEMO=true

# Shows the password-reset token in the API response because no email service is configured.
EXPOSE_RESET_TOKEN=true

# Failed login attempts allowed per 15 minutes per IP.
LOGIN_RATE_LIMIT=10
