{
  "info": {
    "name": "Course Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/../health"
      }
    },
    {
      "name": "Student login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"asha@school.edu\",\n  \"password\": \"asha-learn-2026\"\n}"
        }
      }
    },
    {
      "name": "Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/auth/admin-login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"adminId\": \"ADM-1042\",\n  \"password\": \"Admin@Course2026\"\n}"
        }
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Student\",\n  \"email\": \"new@school.edu\",\n  \"rollNo\": \"STU-100\",\n  \"password\": \"a-long-password-123\"\n}"
        }
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base}}/auth/me"
      }
    },
    {
      "name": "Courses",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/courses"
      }
    },
    {
      "name": "Enroll",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base}}/enrollments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courseId\": \"<courseId>\"\n}"
        }
      }
    },
    {
      "name": "Mark progress",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base}}/progress/<courseId>/module",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"moduleId\": \"m1\",\n  \"kind\": \"photo\"\n}"
        }
      }
    },
    {
      "name": "Notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base}}/notifications"
      }
    },
    {
      "name": "Students (admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base}}/students"
      }
    },
    {
      "name": "Admin stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base}}/admin/stats"
      }
    }
  ]
}